{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatCode",
  "mainBinaryName": "ChatCode",
  "version": "1.0.0",
  "identifier": "com.chatcode.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run build:sidecar && npm run fetch:node"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ChatCode",
        "width": 1280,
        "height": 840,
        "minWidth": 820,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/sidecar.mjs",
      "resources/node",
      "resources/npm"
    ]
  }
}
